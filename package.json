{
  "name": "dsh-skill-list",
  "version": "0.1.0",
  "private": true,
  "description": "Header chip that lists every skill available to the current session.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "author": "dialling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dialling/dsh-skill-list.git"
  },
  "homepage": "https://github.com/dialling/dsh-skill-list#readme",
  "bugs": {
    "url": "https://github.com/dialling/dsh-skill-list/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "skill-md"
  ]
}
